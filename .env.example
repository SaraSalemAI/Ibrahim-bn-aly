# Vercel AI Gateway key (https://vercel.com/docs/ai-gateway). Not needed when deployed on Vercel with OIDC.
AI_GATEWAY_API_KEY=
# Optional: any AI Gateway model id. Defaults to anthropic/claude-sonnet-5.5.
AI_GATEWAY_MODEL=

# Optional: pull issued e-invoices from the ETA portal (read-only). ETA_ENV is preprod or prod.
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
ETA_ENV=preprod

# Optional: defaults for the Team & sync page (your Supabase project).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
