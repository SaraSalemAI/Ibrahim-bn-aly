{
  "name": "console-builder",
  "version": "1.0.0",
  "description": "Build any command console — in code or from a JSON spec — and run it in the terminal, in any web page, or as a standalone offline HTML file.",
  "author": "Sara Salem",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": { "types": "./dist/types/index.d.ts", "import": "./dist/index.mjs" },
    "./browser": "./dist/console-builder.browser.js"
  },
  "bin": { "console-builder": "./dist/cli.mjs" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/cli.mjs studio"
  },
  "keywords": ["console", "cli", "terminal", "repl", "command", "builder"],
  "dependencies": { "zod": "^4.6.7" },
  "devDependencies": { "rolldown": "^1.2.15", "typescript": "^7.0.2", "vitest": "^5.0.5", "@types/node": "^26.6.5" },
  "engines": { "node": ">=20" }
}
